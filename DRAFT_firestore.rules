rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Auth helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Project Validation
    function isValidProject(data) {
      return data.keys().hasAll(['slug', 'title', 'year', 'image']) &&
             data.slug is string && data.slug.size() <= 100 &&
             data.title is string && data.title.size() <= 200 &&
             data.year is string && data.year.size() <= 10 &&
             data.image is string && data.image.size() <= 500;
    }

    match /projects/{projectId} {
      allow read: if true; // Publicly readable
      allow write: if false; // Only manageable via Firebase Console or Admin (for now)
    }
  }
}
